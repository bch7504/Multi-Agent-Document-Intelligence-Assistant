FROM python:3.12-slim

WORKDIR /code
COPY backend/requirements.txt backend/requirements-evaluation.txt /code/backend/
RUN pip install --no-cache-dir --upgrade -r /code/backend/requirements-evaluation.txt
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken_cache
RUN mkdir -p "$TIKTOKEN_CACHE_DIR" && python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"
COPY backend /code/backend

CMD ["python", "-m", "backend.app.evaluation.run_ragas", "--max-cases", "3"]
