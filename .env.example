# Copy this file to .env and fill only the provider you want to use.
# Never commit .env or paste real API keys into the frontend.

# Application
APP_NAME=Multi-Agent Document Intelligence Assistant
APP_VERSION=0.1.0
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# PostgreSQL is created automatically by Docker Compose.
POSTGRES_DB=document_assistant
POSTGRES_USER=document_assistant
POSTGRES_PASSWORD=document_assistant_dev
DATABASE_URL=postgresql+psycopg://document_assistant:document_assistant_dev@localhost:5432/document_assistant

# PDF storage and ingestion
DOCUMENT_STORAGE_PATH=data/uploads
MAX_UPLOAD_BYTES=26214400
DOCUMENT_COLLECTION_NAME=document_chunks

# Required choice: gemini | openrouter | openai | ollama
LLM_PROVIDER=

# Google Gemini (required only when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used only when EMBEDDING_PROVIDER=gemini.
# Text embedding option: models/gemini-embedding-001
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenRouter (required only when LLM_PROVIDER=openrouter)
# The selected model must support structured output/tool calling.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Used only when EMBEDDING_PROVIDER=openrouter.
# See the current catalog at https://openrouter.ai/docs/api/api-reference/embeddings/list-embeddings-models
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=RAG LangChain

# OpenAI (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Used only when EMBEDDING_PROVIDER=openai.
# Choose text-embedding-3-small (lower cost) or text-embedding-3-large (higher quality).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional local runtime (kept for later; active only when Ollama is selected)
# Change LLM_PROVIDER=ollama only after installing Ollama and pulling a model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=16384

# Required choice: openrouter | openai | gemini | ollama
# Each provider has its own editable model variable above/below.
# Ollama runs locally; cloud providers require their matching API key.
# Changing the embedding model requires re-indexing the Milvus collection.
EMBEDDING_PROVIDER=

# Retrieval and prompt context
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
CHUNK_TOKEN_ENCODING=cl100k_base
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RRF_K=60
# dense_only | bm25_only | hybrid_rrf
RETRIEVAL_PROFILE=hybrid_rrf
CONTEXT_MAX_CHUNKS=6
CONTEXT_MAX_CHARACTERS=24000

# Milvus
MILVUS_URI=http://localhost:19530

# Optional crawler identification
USER_AGENT=RAG-LangChain/1.0
